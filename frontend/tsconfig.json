{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    // Type-check the e2e .mjs suite too: a Promise used as a boolean (the
    // `await x && promise` shape) then surfaces as a type error, not as an
    // always-true assertion (QWB-54).
    "checkJs": true,
    // The e2e .mjs files carry no JSDoc types, so strict implicit-any would
    // flood them with errors; the Promise-as-boolean catch does not need it.
    // The TS source stays annotation-clean, so nothing else is lost.
    "noImplicitAny": false,
    // catch variables only ever feed String(...) here; strict's unknown-typed
    // catch would force a cast at every site for no information.
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "e2e/**/*.mjs"
  ],
  "exclude": ["node_modules"]
}
